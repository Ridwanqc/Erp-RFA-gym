# ==============================================================================
# RFA GYM ERP - Environment variables template
# Copy this file to .env and replace the example values before running locally
# or deploying to Dokploy / Docker.
# ==============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfa_gym
DB_SSL=false

# File uploads
UPLOAD_DIR=./uploads

# Authentication
JWT_SECRET=change-me-32-plus-chars-strong-secret
REFRESH_TOKEN_SECRET=change-me-32-plus-chars-strong-refresh-secret

# Optional local dev toggles
DISABLE_HMR=false
CORS_ORIGIN=http://localhost:3000
