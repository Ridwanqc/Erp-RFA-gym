# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL Production Database (Supabase, Neon, Cloud SQL, RDS, VPS)
# Format: postgresql://<username>:<password>@<hostname>:5432/<database_name>?sslmode=require
DATABASE_URL="postgresql://gympro_user:PasswordKuat123!@ep-cool-db.us-east-2.aws.neon.tech:5432/gympro_enterprise?sslmode=require"

# JWT_SECRET: Minimum 32-character high entropy key for signing session tokens
JWT_SECRET="gympro-enterprise-jwt-production-secret-key-32-chars-min"

# REFRESH_TOKEN_SECRET: Key for signing refresh token rotations
REFRESH_TOKEN_SECRET="gympro-enterprise-refresh-production-secret-key-32-chars-min"
