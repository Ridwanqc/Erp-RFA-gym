# NODE_ENV & PORT
NODE_ENV="production"
PORT=3000

# APP_URL: Domain utama tempat aplikasi di-hosting (sesuai domain Dokploy Anda)
APP_URL="https://admin.rfagym.com"

# DATABASE_URL: PostgreSQL Connection URL di Dokploy
# PENTING: Karena username (rfagym0106@gmail.com) dan password (Ridwan@12345) mengandung karakter '@',
# karakter '@' dalam username dan password WAJIB di-encode menjadi '%40' agar parser URL tidak error!
#
# Format: postgresql://<user>:<password>@<internal_host>:5432/<database_name>
#
# URL Siap Pakai untuk Dokploy:
DATABASE_URL="postgresql://rfagym0106%40gmail.com:Ridwan%4012345@rfa-gym-databasegym-5ihc2l:5432/database-gym"

# JWT_SECRET: Kunci enkripsi token sesi (minimal 32 karakter acak)
JWT_SECRET="rfa-gym-erp-enterprise-jwt-secret-key-production-32-chars-min"

# REFRESH_TOKEN_SECRET: Kunci rotasi token sesi
REFRESH_TOKEN_SECRET="rfa-gym-erp-enterprise-refresh-token-secret-32-chars-min"

# GEMINI_API_KEY (Opsional): Diisi jika mengaktifkan fitur AI
# GEMINI_API_KEY=""
