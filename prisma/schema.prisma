datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  LEADER
  KARYAWAN
  KASIR
  TRAINER
  MEMBER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
  VOIDED
  REFUNDED
}

model User {
  id                  String        @id @default(uuid())
  username            String        @unique @db.VarChar(50)
  email               String        @unique @db.VarChar(100)
  passwordHash        String        @db.VarChar(255)
  name                String        @db.VarChar(100)
  role                Role          @default(KARYAWAN)
  status              AccountStatus @default(ACTIVE)
  branchId            String?       @db.VarChar(50)
  branchName          String?       @db.VarChar(100)
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean       @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions            UserSession[]
  auditLogs           AuditLog[]
  transactions        Transaction[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @db.VarChar(36)
  refreshTokenHash String    @db.VarChar(255)
  ipAddress        String?   @db.VarChar(45)
  userAgent        String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @db.VarChar(36)
  action    String   @db.VarChar(50) // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, VOID, REFUND, etc.
  module    String   @db.VarChar(50) // AUTH, MEMBER, TRANSACTION, INVENTORY, CLOSING, etc.
  recordId  String?  @db.VarChar(100)
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid())
  eventType String   @db.VarChar(50) // BRUTE_FORCE, UNAUTHORIZED_ACCESS, IDOR_ATTEMPT, PRICE_TAMPER, etc.
  severity  Severity @default(MEDIUM)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  userId    String?  @db.VarChar(36)
  details   String?  @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
  @@map("security_events")
}

model Member {
  id                String         @id @default(uuid())
  memberCode        String         @unique @db.VarChar(50)
  name              String         @db.VarChar(100)
  phone             String         @db.VarChar(25)
  email             String?        @db.VarChar(100)
  status            String         @default("Aktif") @db.VarChar(30)
  branchId          String         @db.VarChar(50)
  assignedTrainerId String?        @db.VarChar(50)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  memberships       Membership[]
  transactions      Transaction[]

  @@index([phone])
  @@index([branchId])
  @@map("members")
}

model Membership {
  id        String   @id @default(uuid())
  memberId  String   @db.VarChar(36)
  planName  String   @db.VarChar(100)
  price     Decimal  @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime
  status    String   @default("Aktif") @db.VarChar(30)
  isFrozen  Boolean  @default(false)
  createdAt DateTime @default(now())

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("memberships")
}

model Package {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  category     String   @db.VarChar(50) // Membership, PT, Studio
  price        Decimal  @db.Decimal(12, 2)
  durationDays Int      @default(30)
  sessions     Int?     @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("packages")
}

model Transaction {
  id            String            @id @default(uuid())
  invoiceNumber String            @unique @db.VarChar(50)
  memberId      String?           @db.VarChar(36)
  cashierId     String            @db.VarChar(36)
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0.00) @db.Decimal(12, 2)
  tax           Decimal           @default(0.00) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  status        TransactionStatus @default(PAID)
  paymentMethod String            @db.VarChar(50)
  isVoided      Boolean           @default(false)
  voidReason    String?           @db.VarChar(255)
  voidedBy      String?           @db.VarChar(100)
  voidedAt      DateTime?
  closingId     String?           @db.VarChar(50)
  createdAt     DateTime          @default(now())

  member        Member?           @relation(fields: [memberId], references: [id])
  cashier       User              @relation(fields: [cashierId], references: [id])
  payments      Payment[]

  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Payment {
  id            String   @id @default(uuid())
  transactionId String   @db.VarChar(36)
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @db.VarChar(50)
  status        String   @default("SUCCESS") @db.VarChar(30)
  verifiedBy    String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("payments")
}

model DailyClosing {
  id           String    @id @default(uuid())
  closingDate  DateTime
  branchId     String    @db.VarChar(50)
  cashierId    String    @db.VarChar(50)
  totalCash    Decimal   @db.Decimal(12, 2)
  totalNonCash Decimal   @db.Decimal(12, 2)
  totalAmount  Decimal   @db.Decimal(12, 2)
  status       String    @default("CLOSED") @db.VarChar(30)
  closedAt     DateTime  @default(now())

  @@index([closingDate])
  @@map("daily_closings")
}

model BackupRecord {
  id        String   @id @default(uuid())
  filename  String   @db.VarChar(100)
  sizeBytes Int      @default(0)
  checksum  String   @db.VarChar(64)
  status    String   @default("COMPLETED") @db.VarChar(30)
  createdAt DateTime @default(now())

  @@map("backup_records")
}
